{
  "info": {
    "_postman_id": "b8d40860-62ef-4db2-91f5-employee-wallet-payroll",
    "name": "Employee Wallet & Payroll Integration",
    "description": "Main take-home API flows for employees, wallets, simulated payroll events, withdrawals, bank callbacks, idempotency, and ledger history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
